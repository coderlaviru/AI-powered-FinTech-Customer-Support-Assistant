# Copy this file to .env and add your own xAI (Grok) API key.
XAI_API_KEY=your_xai_api_key_here
# Verify the exact model id in the xAI console (https://console.x.ai).
XAI_MODEL=grok-4-fast-non-reasoning
XAI_BASE_URL=https://api.x.ai/v1

# Local embeddings (downloaded once from Hugging Face, then run offline on your machine).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Query-side instruction. Set automatically for BGE English models; use an empty value to disable.
# EMBEDDING_QUERY_PREFIX=

# Retrieval strategy: dense | hybrid | hybrid_rerank
RETRIEVAL_MODE=hybrid_rerank
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval tuning
TOP_K=5
CANDIDATE_K=20
RERANK_POOL=12
# Refuse without calling the LLM when the best chunk's cosine similarity is below this value.
# Calibrate it with `python evaluate.py` (see README).
MIN_SIMILARITY=0.40

# Chunking (sizes are counted in whitespace-delimited words)
CHUNK_MAX_WORDS=250
CHUNK_OVERLAP_WORDS=40

# Conversation memory: number of previous messages sent for follow-up rewriting
HISTORY_TURNS=6

# RAG_DATA_DIR=data
# RAG_INDEX_DIR=storage
